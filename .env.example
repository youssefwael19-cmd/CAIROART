# --- AI (optional) -------------------------------------------------------
# Without a key the app runs on its built-in bilingual rules engine.
# (Demo credentials are off unless DEMO_ACCOUNTS=1 is set below.)
# With a key it uses any OpenAI-compatible endpoint for replies and analysis.
OPENAI_API_KEY=
AI_BASE_URL=https://freebuff.com/api/v1/paid
AI_MODEL=gpt-4o-mini

# --- Storage ------------------------------------------------------------
# Uploads, the share secret, the one-time manager password and daily backups
# live under DATA_DIR. On a hosted platform point it at the mounted volume
# (e.g. /data) so they survive every deploy. SQLITE_PATH overrides just the
# local database file.
DATA_DIR=
SQLITE_PATH=

# --- Database -----------------------------------------------------------
# Empty: data stays in a local SQLite file (development and tests).
# Set by the host: everything goes to Postgres instead, and the app refuses to
# write a local SQLite file. Managed URLs often end in sslmode=require;
# PGSSL=1 forces TLS when they do not.
DATABASE_URL=
PGSSL=
PG_POOL_MAX=

# --- Runtime ------------------------------------------------------------
# The port to listen on. Hosts inject PORT; it defaults to 8787 locally.
PORT=
# 1 seeds the sample catalog, conversations, orders and sales figures when the
# database is empty. A real business database should start without it.
SEED_DEMO=

# --- Staff access -------------------------------------------------------
# Local demos only: shows the demo credentials on the sign-in screen.
# Never set this on a published deployment.
DEMO_ACCOUNTS=
# Optional, at least 10 characters: the first manager's starting password, for
# hosts with no shell to read the generated one. Applied at boot only while
# that manager has never signed in. Remove it after the first sign-in.
INITIAL_MANAGER_PASSWORD=
# Set to 1 only when the API sits behind a reverse proxy you control, so the
# sign-in throttle can read X-Forwarded-For safely.
TRUST_PROXY=
# Signs customer confirmation links. Generated and stored in data/ if empty.
SHARE_SECRET=

# --- WhatsApp Cloud API (optional) --------------------------------------
# Add these to go live on real WhatsApp traffic. Without them the inbox
# runs in simulated mode with an identical qualification flow.
# The webhook refuses every delivery until WHATSAPP_APP_SECRET is set:
# it is used to verify Meta's X-Hub-Signature-256 header.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Webhook URL to register with Meta:
#   https://<your-domain>/api/whatsapp/webhook
